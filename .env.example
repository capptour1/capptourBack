DB_HOST=tu_host_de_base_de_datos
DB_PORT=5432
DB_NAME=tu_base_de_datos
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña

# JWT — cambia este valor por una cadena larga y aleatoria en producción
JWT_SECRET=tu_jwt_secret_largo_y_aleatorio

# Google Sign-In — reemplaza con tu Web Client ID de Google Cloud Console
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Apple Sign-In — rellena con los datos de tu Apple Developer account
APPLE_CLIENT_ID=co.capptour.cap_tour_app
APPLE_TEAM_ID=TU_TEAM_ID
APPLE_KEY_ID=TU_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----)"

# Storage — almacenamiento de archivos
STORAGE_PATH=./storage
STORAGE_BASE_URL=http://localhost:3000/storage

# PhotoRoom API — solo para la demo de edición de imágenes
# Configurar en el entorno de ejecución (nunca en este archivo).
# Ejemplo: PHOTOROOM_API_KEY=sandbox_xxxxxxxxxxxxxxxx
PHOTOROOM_API_KEY=
